#include <ESP32Servo.h>
// ==== PIN Definitions ====
#define IN1 32
#define IN2 33
#define ENA 14
#define SERVO_PIN 2
#define SERVO_LEFT 30
#define SERVO_RIGHT 140
#define SERVO_STRAIGHT 90
#define TRIG_FRONT 5
#define ECHO_FRONT 35   // input-only pin, read only
#define TRIG_RIGHT 19
#define ECHO_RIGHT 34   // input-only pin, read only
#define TRIG_LEFT 23
#define ECHO_LEFT 36    // input-only pin, read only

// ==== Tuning ====
const int DRIVE_SPEED = 150;
const int TURN_SPEED = 160;
const int REVERSE_SPEED = 120;
const int TURN_DURATION_MS = 900;    // timed turn, no IMU to close the loop
const int REVERSE_DURATION_MS = 700;
const float FRONT_GAP = 65.0;        // cm ahead before we commit to a turn
const float SIDE_GAP = 90.0;         // cm to the side that counts as open

Servo steeringservo;
int turn_count = 0;

float readUltrasonicDistance(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  long duration = pulseIn(echoPin, HIGH, 30000);
  if (duration == 0) return 999.0;
  float distance = duration * 0.034 / 2.0;
  return (distance > 0 && distance < 400) ? distance : 999.0;
}
void drive(int speed, bool forward) {
  digitalWrite(IN1, forward ? LOW : HIGH);
  digitalWrite(IN2, forward ? HIGH : LOW);
  analogWrite(ENA, speed);
}
void stopMotors() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, HIGH);
  analogWrite(ENA, 0);
}
void reverseBeforeTurn() {
  drive(REVERSE_SPEED, false);
  delay(REVERSE_DURATION_MS);
  stopMotors();
  delay(200);
}
void turn90(int servoAngle) {
  steeringservo.write(servoAngle);
  delay(300);
  drive(TURN_SPEED, true);
  delay(TURN_DURATION_MS);
  stopMotors();
  steeringservo.write(SERVO_STRAIGHT);
  delay(400);
  Serial.println("Turn " + String(++turn_count) + " done");
}
void setup() {
  Serial.begin(115200);
  int outs[] = {IN1, IN2, ENA, TRIG_FRONT, TRIG_RIGHT, TRIG_LEFT};
  for (int p : outs) pinMode(p, OUTPUT);
  int ins[] = {ECHO_FRONT, ECHO_RIGHT, ECHO_LEFT};
  for (int p : ins) pinMode(p, INPUT);
  steeringservo.attach(SERVO_PIN);
  steeringservo.write(SERVO_STRAIGHT);
  Serial.println("Ready.");
}
void loop() {
  float distFront = readUltrasonicDistance(TRIG_FRONT, ECHO_FRONT);
  float distRight = readUltrasonicDistance(TRIG_RIGHT, ECHO_RIGHT);
  float distLeft = readUltrasonicDistance(TRIG_LEFT, ECHO_LEFT);
  if (distFront < 25) {
    reverseBeforeTurn();
  } else if (distFront < FRONT_GAP && distRight > SIDE_GAP && distLeft < SIDE_GAP) {
    reverseBeforeTurn();
    turn90(SERVO_RIGHT);
  } else if (distFront < FRONT_GAP && distLeft > SIDE_GAP && distRight < SIDE_GAP) {
    reverseBeforeTurn();
    turn90(SERVO_LEFT);
  } else {
    drive(DRIVE_SPEED, true);
    steeringservo.write(SERVO_STRAIGHT);
  }
  delay(50);
}
